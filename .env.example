# --- OpenAI Realtime (server side only; never sent to the extension) ---
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Translation model requested in the upstream WebSocket URL. Verified default.
OPENAI_REALTIME_MODEL=gpt-realtime-translate
# Upstream WebSocket URL. Default is the documented translation endpoint.
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime/translations?model=gpt-realtime-translate
# Target language for translated output audio and transcript deltas.
# Source language is auto-detected. Supported: es pt fr ja ru zh de ko
# hi id vi it en.
OPENAI_TRANSLATION_TARGET_LANGUAGE=en
# Model used only for source-language transcript deltas.
OPENAI_TRANSLATION_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# Source language for same-language detection. Empty means auto-detect
# (translation path). When it matches the target language, the session
# transcribes instead of translating (see below).
OPENAI_TRANSLATION_SOURCE_LANGUAGE=
# Deployment-wide mode switch. false (default) translates; true makes
# every session transcribe with OPENAI_TRANSCRIPTION_MODEL instead.
TRANSCRIBE_MODE=false
# Transcription model and endpoint for transcribe mode and same-language
# sessions. Transcripts map to the same client transcript.delta /
# transcript.completed events the extension already renders.
OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-transcribe
OPENAI_TRANSCRIPTION_URL=wss://api.openai.com/v1/realtime?intent=transcription

# --- Client WebSocket limits ---
# Comma-separated allowed Origin values, or "*" for local development.
# Origin checks are NOT authentication: anyone who can reach the endpoint
# may consume OpenAI API quota. Keep this on localhost without extra guards.
ALLOWED_WEBSOCKET_ORIGINS=*
# Max size of one inbound WebSocket text message, in bytes.
MAX_WEBSOCKET_MESSAGE_BYTES=65536
# Max simultaneous translation sessions (one upstream socket each).
MAX_CONCURRENT_SESSIONS=10
# Close sessions idle (no client message) for longer than this, in seconds.
SESSION_IDLE_TIMEOUT_SECONDS=120
# Max decoded audio bytes accepted per second, per session.
# Mono PCM16 @ 24 kHz is 48_000 bytes/s; default allows ~2x headroom.
MAX_AUDIO_BYTES_PER_SECOND=96000

# --- WebRTC DataChannel audio (extensionRTC build) ---
# Must match DATA_CHANNEL_LABEL in extensionRTC/rtc-config.js.
WEBRTC_DATA_CHANNEL_LABEL=audio

# --- Debug audio recorder (never enable in production) ---
# Saves validated inbound client audio as WAV (mono PCM16 24 kHz) under
# RECEIVED_AUDIO_DIR so silent sessions can be diagnosed by ear.
SAVE_RECEIVED_AUDIO=false
RECEIVED_AUDIO_DIR=recordings

# --- Logging (never logs audio, keys, or transcript content) ---
LOG_LEVEL=DEBUG
